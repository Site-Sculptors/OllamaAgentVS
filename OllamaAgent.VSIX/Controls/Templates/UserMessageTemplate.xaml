<DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
    <Border
        MaxWidth="400"
        Margin="30,8,8,8"
        Padding="8"
        HorizontalAlignment="Right"
        Background="#E3F2FD"
        BorderBrush="#2196F3"
        BorderThickness="1"
        CornerRadius="8">
        <TextBlock
            Foreground="#0D47A1"
            Text="{Binding Message}"
            TextWrapping="Wrap" />
    </Border>
</DataTemplate>
