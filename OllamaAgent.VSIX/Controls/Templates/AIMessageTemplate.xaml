<DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
    <Border
        MaxWidth="400"
        Margin="8,8,30,8"
        Padding="8"
        HorizontalAlignment="Left"
        Background="#F5F5F5"
        BorderBrush="#BDBDBD"
        BorderThickness="1"
        CornerRadius="8">
        <TextBlock
            Foreground="#333"
            Text="{Binding Message}"
            TextWrapping="Wrap" />
    </Border>
</DataTemplate>
