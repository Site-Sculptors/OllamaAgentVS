<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" >
  <DataTemplate
      x:Key="AIMessageTemplate">
    <TextBlock
        Foreground="{DynamicResource ToolWindowText}"
        Text="{Binding Message}" HorizontalAlignment="Left" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ListBox}}"
        TextWrapping="Wrap" />
  </DataTemplate>
</ResourceDictionary>
