<UserControl
    x:Class="OllamaAgent.VSIX.Controls.OllamaAgentToolWindowControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:OllamaAgent.VSIX.Converters"
    xmlns:viewModels="clr-namespace:OllamaAgent.VSIX.ViewModels">
    <UserControl.Resources>
        <converters:ServerStatusToBrushConverter x:Key="ServerStatusToBrushConverter" />
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Padding="5,2"
                            VerticalAlignment="Center"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3">
                            <!--  Change this value as needed  -->
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Simple header  -->
        <StackPanel
            Grid.Row="0"
            Margin="10"
            Orientation="Horizontal">
            <Ellipse
                Width="8"
                Height="8"
                Fill="{Binding Status, Converter={StaticResource ServerStatusToBrushConverter}}" />
            <Button
                x:Name="StartServerButton"
                Margin="5,0,20,0"
                Background="Transparent"
                Command="{Binding StartServerCommand}"
                Content="{Binding Status}"
                Foreground="{Binding Status, Converter={StaticResource ServerStatusToBrushConverter}}"
                ToolTip="Click to start the Ollama server" />
            <Button
                x:Name="ReloadButton"
                Margin="5"
                Command="{Binding ReloadCommand}"
                Content="Reload" />
            <Button
                x:Name="SettingsButton"
                Margin="5"
                Command="{Binding SettingsCommand}"
                Content="Settings" />
            <Button
                x:Name="NewThreadButton"
                Margin="5"
                Command="{Binding NewThreadCommand}"
                Content="New" />
        </StackPanel>

        <!--  Chat display  -->
        <ListBox
            x:Name="ChatHistory"
            Grid.Row="1"
            Margin="10"
            ItemsSource="{Binding ChatHistory}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Display}" TextWrapping="Wrap" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!--  Simple input  -->
        <TextBox
            x:Name="InputBox"
            Grid.Row="2"
            MinHeight="60"
            Margin="10"
            AcceptsReturn="True"
            Text="{Binding Input, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            TextWrapping="Wrap" />
        <StackPanel
            Grid.Row="3"
            Margin="10"
            Orientation="Horizontal">
            <ComboBox
                x:Name="ModelSelector"
                Width="120"
                Margin="5"
                ItemsSource="{Binding Models}"
                SelectedItem="{Binding SelectedModel, Mode=TwoWay}" />
            <Button
                Width="60"
                Margin="5"
                Command="{Binding SendCommand}"
                Content="Send" />
        </StackPanel>
    </Grid>
</UserControl>