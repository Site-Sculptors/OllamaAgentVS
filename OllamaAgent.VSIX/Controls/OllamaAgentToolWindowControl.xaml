<UserControl
    x:Class="OllamaAgent.VSIX.Controls.OllamaAgentToolWindowControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:OllamaAgent.VSIX.Converters"
    xmlns:viewModels="clr-namespace:OllamaAgent.VSIX.ViewModels"
    xmlns:watermark="clr-namespace:OllamaAgent.VSIX.Controls">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--  Centralized dictionaries  -->
                <ResourceDictionary Source="/OllamaAgent.VSIX;component/Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="/OllamaAgent.VSIX;component/Resources/Styles/Styles.xaml" />
                <ResourceDictionary Source="/OllamaAgent.VSIX;component/Resources/FontResources.xaml" />
                <ResourceDictionary Source="/OllamaAgent.VSIX;component/Controls/Templates/UserMessageTemplate.xaml" />
                <ResourceDictionary Source="/OllamaAgent.VSIX;component/Controls/Templates/AIMessageTemplate.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  Converters  -->
            <converters:ServerStatusToBrushConverter x:Key="ServerStatusToBrushConverter" />
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />

            <!--  Template selector for chat messages  -->
            <watermark:ChatMessageTemplateSelector
                x:Key="ChatMessageTemplateSelector"
                AITemplate="{StaticResource AIMessageTemplate}"
                UserTemplate="{StaticResource UserMessageTemplate}" />

            <!--  Faux button border style (for status indicator)  -->
            <Style x:Key="FauxButtonBorderStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="5" />
                <Setter Property="Padding" Value="5,0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="{DynamicResource ColorBackgroundInput}" />
            </Style>

            <!--  Default Button Style - uses centralized button style  -->
            <Style BasedOn="{StaticResource StyleButton}" TargetType="Button" />

            <!--  Toolbar icon button style (text-based icons like FontAwesome)  -->

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ColorBackgroundPrimary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="10,0"
            VerticalAlignment="Center"
            FontSize="12"
            FontStyle="Italic"
            FontWeight="Bold"
            Foreground="Gray"
            Text="{Binding ActiveThread.Name}"
            TextTrimming="CharacterEllipsis"
            TextWrapping="NoWrap"
            ToolTip="{Binding ActiveThread.Name}" />

        <!--  Custom Instructions Indicator  -->
        <StackPanel
            Grid.Row="0"
            Margin="0,0,10,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Border
                Padding="4,1"
                Background="#FFE6C200"
                CornerRadius="4"
                ToolTip="Custom instructions are active and prepended to every prompt."
                Visibility="{Binding CustomInstructionsActive, Converter={StaticResource BoolToVis}}">
                <TextBlock
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="Black"
                    Text="Custom Instructions" />
            </Border>
        </StackPanel>

        <!--  Toolbar Row  -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  Status Indicator (Ollama server status)  -->
            <Border
                Grid.Column="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Style="{StaticResource FauxButtonBorderStyle}">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse
                        Grid.Column="0"
                        Width="8"
                        Height="8"
                        Margin="0"
                        VerticalAlignment="Center"
                        Fill="{Binding Status, Converter={StaticResource ServerStatusToBrushConverter}}" />
                    <Button
                        x:Name="StartServerButton"
                        Grid.Column="1"
                        Height="20"
                        MinHeight="10"
                        Margin="4,0,0,0"
                        Padding="0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding StartServerCommand}"
                        Content="{Binding Status}"
                        Foreground="{Binding Status, Converter={StaticResource ServerStatusToBrushConverter}}"
                        ToolTip="Click to start the Ollama server" />
                </Grid>
            </Border>

            <!--  Toolbar Buttons  -->
            <Button
                x:Name="ReloadButton"
                Grid.Column="1"
                Margin="5"
                Command="{Binding ReloadCommand}"
                Content="&#xf2f9;"
                FontFamily="{StaticResource FASolid}"
                Style="{StaticResource ToolbarIconButtonStyle}"
                ToolTip="Reload" />

            <Button
                Grid.Column="2"
                Margin="5"
                Command="{Binding ChatHistoryCommand}"
                Content="&#xf017;"
                FontFamily="{StaticResource FASolid}"
                Style="{StaticResource ToolbarIconButtonStyle}"
                ToolTip="Chat History" />

            <Button
                x:Name="SettingsButton"
                Grid.Column="3"
                Margin="5"
                Command="{Binding SettingsCommand}"
                Content="&#xf013;"
                FontFamily="{StaticResource FASolid}"
                Style="{StaticResource ToolbarIconButtonStyle}"
                ToolTip="Settings" />

            <Button
                x:Name="NewThreadButton"
                Grid.Column="4"
                Margin="5"
                Command="{Binding NewThreadCommand}"
                Content="&#xe901;"
                FontFamily="{StaticResource IconMoon}"
                FontSize="15"
                Style="{StaticResource ToolbarIconButtonStyle}"
                ToolTip="New Chat" />

            <Button
                Grid.Column="5"
                Margin="5"
                Command="{Binding DeleteThreadCommand}"
                Content="&#xe900;"
                FontFamily="{StaticResource IconMoon}"
                FontSize="15"
                Style="{StaticResource ToolbarIconButtonStyle}"
                ToolTip="Delete Chat" />
        </Grid>

        <!--  Chat Threads List (History View)  -->
        <ListBox
            x:Name="ChatThreadsList"
            Grid.Row="2"
            Margin="10"
            Background="{DynamicResource ColorBackgroundPrimary}"
            BorderBrush="{DynamicResource ColorBorderPrimary}"
            ItemsSource="{Binding Threads}"
            SelectedItem="{Binding ActiveThread, Mode=TwoWay}"
            Visibility="{Binding IsHistoryVisible, Converter={StaticResource BoolToVis}}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock
                        MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ListBox}}"
                        Foreground="{DynamicResource ColorTextPrimary}"
                        Text="{Binding Name}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!--  Current Chat Messages  -->
        <ListBox
            x:Name="CurrentChat"
            Grid.Row="2"
            MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ListBox}}"
            Margin="10"
            HorizontalContentAlignment="Stretch"
            Background="Transparent"
            BorderThickness="0"
            ItemTemplateSelector="{StaticResource ChatMessageTemplateSelector}"
            ItemsSource="{Binding ChatHistory}"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            Visibility="{Binding IsHistoryVisible, Converter={StaticResource InverseBoolToVis}}" />

        <!--  Input Area (Bottom)  -->
        <Border
            Grid.Row="3"
            Margin="10"
            Padding="5"
            Background="{DynamicResource ColorBackgroundInput}"
            BorderThickness="0"
            CornerRadius="5">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Row="0"
                    Grid.Column="0"
                    Grid.ColumnSpan="5"
                    Orientation="Horizontal">
                    <Border
                        Margin="5,0,0,0"
                        Padding="6,2"
                        HorizontalAlignment="Left"
                        Background="#22ffffff"
                        BorderThickness="0"
                        CornerRadius="6">
                        <Button
                            Width="18"
                            Height="18"
                            Margin="0,0,4,0"
                            Padding="0"
                            VerticalAlignment="Center"
                            BorderBrush="{DynamicResource ColorTextPrimary}"
                            BorderThickness="1"
                            Command="{Binding AttachFileCommand}"
                            Content="&#xf067;"
                            FontFamily="{StaticResource FASolid}"
                            Style="{StaticResource ToolbarIconButtonStyle}"
                            ToolTip="Add attachment" />

                    </Border>
                    <Border
                        Margin="5,0,0,0"
                        Padding="6,2"
                        HorizontalAlignment="Left"
                        Background="#22ffffff"
                        BorderThickness="0"
                        CornerRadius="6">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <TextBlock
                                FontWeight="Bold"
                                Foreground="{DynamicResource ColorTextPrimary}"
                                Text="{Binding AttachedFileName}" />
                            <TextBlock
                                Margin="6,0"
                                FontWeight="ExtraBold"
                                Foreground="{DynamicResource ColorTextPrimary}"
                                Text="|" />
                            <Button
                                Width="18"
                                Height="18"
                                Margin="4,0,0,0"
                                Padding="0"
                                VerticalAlignment="Center"
                                Command="{Binding ClearAttachmentCommand}"
                                Content="&#xf067;"
                                FontFamily="{StaticResource FASolid}"
                                Style="{StaticResource ToolbarIconButtonStyle}"
                                ToolTip="Remove attachment" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!--  Text Input Box  -->
                <Grid
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="5">
                    <TextBox
                        x:Name="InputBox"
                        MinHeight="60"
                        Margin="10"
                        watermark:WatermarkService.Watermark="Chat with Ollama..."
                        watermark:WatermarkService.WatermarkFontSize="12"
                        AcceptsReturn="True"
                        Background="{DynamicResource ColorBackgroundInput}"
                        BorderThickness="0"
                        FontSize="12"
                        Foreground="{DynamicResource ColorTextInput}"
                        PreviewKeyDown="InputBox_PreviewKeyDown"
                        PreviewKeyUp="InputBox_PreviewKeyUp"
                        Text="{Binding Input, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap" />
                    <Popup
                        x:Name="SlashCommandPopup"
                        AllowsTransparency="True"
                        Focusable="False"
                        IsOpen="{Binding IsSlashCommandPopupOpen, Mode=TwoWay}"
                        Placement="Top"
                        PlacementTarget="{Binding ElementName=InputBox}"
                        StaysOpen="False">
                        <Border
                            Background="{DynamicResource ColorBackgroundInput}"
                            BorderBrush="Gray"
                            BorderThickness="1"
                            CornerRadius="4">
                            <ListBox
                                x:Name="SlashCommandListBox"
                                MinWidth="220"
                                MaxHeight="160"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{DynamicResource ColorTextInput}"
                                ItemsSource="{Binding SlashCommandSuggestions}"
                                KeyboardNavigation.DirectionalNavigation="Continue"
                                KeyboardNavigation.TabNavigation="Continue"
                                SelectedIndex="{Binding SlashCommandSelectedIndex, Mode=TwoWay}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="4,2" Orientation="Vertical">
                                            <TextBlock FontWeight="Bold" Text="{Binding Command}" />
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="Gray"
                                                Text="{Binding Description}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Popup>
                </Grid>

                <!--  Model Selector  -->
                <ComboBox
                    Grid.Row="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Width="Auto"
                    MinWidth="200"
                    Margin="5"
                    HorizontalAlignment="Left"
                    DisplayMemberPath="Name"
                    IsEnabled="{Binding AgentEnabled}"
                    ItemsSource="{Binding Models}"
                    SelectedItem="{Binding SelectedChatModel, Mode=TwoWay}" />

                <!--  Attach File Button  -->
                <!--<Button
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin="5"
                    Command="{Binding AttachFileCommand}"
                    Content="&#xf0c6;"
                    FontFamily="{StaticResource FASolid}"
                    Style="{StaticResource ToolbarIconButtonStyle}"
                    ToolTip="Attach File" />-->



                <!--  Tools Button  -->
                <Button
                    Grid.Row="2"
                    Grid.Column="3"
                    Margin="5"
                    HorizontalAlignment="Right"
                    Command="{Binding ToolsCommand}"
                    Content="&#xf0ad;"
                    FontFamily="{StaticResource FASolid}"
                    Style="{StaticResource ToolbarIconButtonStyle}"
                    ToolTip="Tools" />

                <!--  Send Button  -->
                <Button
                    Grid.Row="2"
                    Grid.Column="4"
                    Margin="5"
                    HorizontalAlignment="Right"
                    Command="{Binding SendCommand}"
                    Content="&#xf1d8;"
                    FontFamily="{StaticResource FASolid}"
                    Style="{StaticResource ToolbarIconButtonStyle}"
                    ToolTip="Send"
                    Visibility="{Binding IsStreaming, Converter={StaticResource InverseBoolToVis}}" />

                <!--  Stop Streaming Button  -->
                <Button
                    Grid.Row="2"
                    Grid.Column="4"
                    Margin="5"
                    HorizontalAlignment="Right"
                    Command="{Binding StopStreamingCommand}"
                    Content="&#xf04d;"
                    FontFamily="{StaticResource FASolid}"
                    Style="{StaticResource ToolbarIconButtonStyle}"
                    ToolTip="Stop"
                    Visibility="{Binding IsStreaming, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Border>

        <!--  Typing Indicator / Blinking Cursor  -->
        <TextBlock
            Grid.Row="3"
            Margin="10,0,0,10"
            FontSize="13"
            FontStyle="Italic"
            Foreground="Gray"
            Text="Ollama is typing... |"
            Visibility="{Binding IsStreaming, Converter={StaticResource BoolToVis}}" />
    </Grid>
</UserControl>