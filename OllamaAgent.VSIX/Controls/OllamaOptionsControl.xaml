<UserControl
    x:Class="OllamaAgent.VSIX.Controls.OllamaOptionsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:OllamaAgent.VSIX.Converters"
    xmlns:viewModels="clr-namespace:OllamaAgent.VSIX.ViewModels"
    MinHeight="600">
    <UserControl.Resources>
        <converters:ServerStatusToBrushConverter x:Key="ServerStatusToBrushConverter" />
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ToolWindowButtonBackground}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Padding="5,2"
                            VerticalAlignment="Center"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3">
                            <!--  Change this value as needed  -->
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel  Margin="12">
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
            <Ellipse
                Width="8"
                Height="8"
                Fill="{Binding Status, Converter={StaticResource ServerStatusToBrushConverter}}" />
            <Button
                x:Name="StartServerButton"
                Margin="5,0,20,0"
                Background="Transparent"
                Command="{Binding StartServerCommand}"
                Content="{Binding Status}"
                Foreground="{Binding Status, Converter={StaticResource ServerStatusToBrushConverter}}"
                IsEnabled="{Binding ExtensionEnabled}"
                ToolTip="Click to start the Ollama server" />

            <Button
                Grid.Row="2"
                Grid.Column="1"
                Margin="10,0"
                Command="{Binding TestConnectionCommand}"
                Content="Test Connection"
                IsEnabled="{Binding ExtensionEnabled}" />

            <Button
                Grid.Row="2"
                Grid.Column="2"
                Command="{Binding RefreshModelsCommand}"
                Content="Refresh Models"
                IsEnabled="{Binding ExtensionEnabled}" />
        </StackPanel>
        <TextBlock Margin="0,10,0,0" Text="Ollama Endpoint" />
        <TextBox IsEnabled="{Binding ExtensionEnabled}" Text="{Binding OllamaEndpoint, UpdateSourceTrigger=PropertyChanged}" />

        <!--  Models Directory Picker  -->
        <TextBlock
            Margin="0,8,0,0"
            VerticalAlignment="Center"
            Text="Models Directory:" />
        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
            <TextBox
                Width="Auto"
                MinWidth="200"
                VerticalAlignment="Center"
                IsReadOnly="True"
                Text="{Binding ModelsDirectory}" />
            <Button
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                Command="{Binding SelectModelsDirectoryCommand}"
                Content="Browse..."
                IsEnabled="{Binding ExtensionEnabled}" />
        </StackPanel>
        <TextBlock
            Margin="0,8,0,0"
            VerticalAlignment="Center"
            Text="Chats Save Directory:" />
        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
            <TextBox
                Width="Auto"
                MinWidth="200"
                VerticalAlignment="Center"
                IsReadOnly="True"
                Text="{Binding ChatsDirectory}" />
            <Button
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                Command="{Binding SelectChatDirectoryCommand}"
                Content="Browse..."
                IsEnabled="{Binding ExtensionEnabled}" />
        </StackPanel>

        <StackPanel VerticalAlignment="Center" Orientation="Vertical">
            <TextBlock Margin="0,10,0,0" Text="Chat Model" />
            <ComboBox
                DisplayMemberPath="Name"
                IsEnabled="{Binding ExtensionEnabled}"
                ItemsSource="{Binding Models}"
                SelectedItem="{Binding SelectedChatModel, Mode=TwoWay}" />
        </StackPanel>
        <StackPanel VerticalAlignment="Center" Orientation="Vertical">
            <TextBlock Margin="0,10,0,0" Text="CompletionModel" />
            <ComboBox
                DisplayMemberPath="Name"
                IsEnabled="{Binding ExtensionEnabled}"
                ItemsSource="{Binding Models}"
                SelectedItem="{Binding SelectedCompletionModel, Mode=TwoWay}" />
        </StackPanel>
        <TextBlock
            Margin="0,8,0,0"
            Foreground="DarkSlateGray"
            Text="{Binding TestConnectionMessage}"
            TextWrapping="Wrap" />


        <CheckBox
            VerticalAlignment="Center"
            Content="Enable referencing your #solution (Requires restart)"
            IsChecked="{Binding ReferenceSolutionEnabled}" />
        <CheckBox
            Margin="0,10"
            VerticalAlignment="Center"
            Content="Auto attach Active Document"
            IsChecked="{Binding AutoAttachActiveDocument}" />
        <CheckBox
            VerticalAlignment="Center"
            Content="Extension Enabled"
            IsChecked="{Binding ExtensionEnabled}" />

    </StackPanel>

</UserControl>