<UserControl
    x:Class="OllamaAgent.VSIX.OllamaAgentToolWindowControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Simple header  -->
        <StackPanel
            Grid.Row="0"
            Margin="10"
            Orientation="Horizontal">
            <Button
                x:Name="ReloadButton"
                Margin="5"
                Content="Reload"
                Command="{Binding ReloadCommand}" />
            <Button
                x:Name="SettingsButton"
                Margin="5"
                Content="Settings"
                Command="{Binding SettingsCommand}" />
            <Button
                x:Name="NewThreadButton"
                Margin="5"
                Content="New"
                Command="{Binding NewThreadCommand}" />
        </StackPanel>

        <!--  Chat display  -->
        <ListBox
            x:Name="ChatHistory"
            Grid.Row="1"
            Margin="10"
            ItemsSource="{Binding ChatHistory}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Display}" TextWrapping="Wrap" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!--  Simple input  -->
        <TextBox
            x:Name="InputBox"
            Grid.Row="2"
            MinHeight="60"
            Margin="10"
            AcceptsReturn="True"
            Text="{Binding Input, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            TextWrapping="Wrap" />
        <StackPanel
            Grid.Row="3"
            Margin="10"
            Orientation="Horizontal">
            <ComboBox
                x:Name="ModelSelector"
                Width="120"
                Margin="5"
                ItemsSource="{Binding Models}"
                SelectedItem="{Binding SelectedModel, Mode=TwoWay}" />
            <Button
                Content="Send"
                Margin="5"
                Width="60"
                Command="{Binding SendCommand}" />
        </StackPanel>
    </Grid>
</UserControl>