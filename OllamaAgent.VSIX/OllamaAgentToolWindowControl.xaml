<UserControl
    x:Class="OllamaAgent.VSIX.OllamaAgentToolWindowControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Button
            Margin="5"
            Padding="6"
            Click="AskButton_Click"
            Content="Ask Ollama Agent" />

        <TextBox
            x:Name="OutputBox"
            Grid.Row="1"
            Margin="5"
            AcceptsReturn="True"
            TextWrapping="Wrap"
            VerticalScrollBarVisibility="Auto" />
    </Grid>
</UserControl>