<Window x:Class="OllamaAgent.VSIX.Views.ServerActionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ollama Server Running" Height="180" Width="400" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="ToolWindow">
    <StackPanel Margin="20">
        <TextBlock Text="Ollama server is already online." FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
        <TextBlock Text="What would you like to do?" Margin="0,0,0,20"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" >
            <Button x:Name="StopButton" Content="Stop" Width="80" Margin="10,0" Click="StopButton_Click"/>
            <Button x:Name="RestartButton" Content="Restart" Width="80" Margin="10,0" Click="RestartButton_Click"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="80" Margin="10,0" Click="CancelButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
